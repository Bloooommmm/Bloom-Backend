generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model MsUser {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  password  String?  
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MsLesson { 
  id                String   @id @default(cuid())
  title             String
  slug              String   @unique 
  content           String   @db.Text 
  estimatedReadTime Int      
  isPublished       Boolean  @default(true)
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}