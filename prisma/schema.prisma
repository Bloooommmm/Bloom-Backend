generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

model MsUser {
  id          String  @id @default(cuid())
  email       String  @unique
  firebaseUid String? @unique
  name        String?
  password    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  periods TrPeriod[]
  moods   TrMood[]
}

model MsLesson {
  id                String  @id @default(cuid())
  title             String
  slug              String  @unique
  content           String  @db.Text
  estimatedReadTime Int
  isPublished       Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TrPeriod {
  id        String    @id @default(cuid())
  userId    String
  startDate DateTime  @db.Date
  endDate   DateTime? @db.Date
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user MsUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, startDate])
}

model TrMood {
  id        String   @id @default(cuid())
  userId    String
  mood      String
  note      String?
  loggedAt  DateTime @db.Date
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user MsUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, loggedAt])
  @@index([userId, loggedAt])
}
