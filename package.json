{
  "name": "bloom-backend",
  "version": "1.0.0",
  "description": "Bloom API for cycle education and AI insights",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src prisma/seed.ts prisma.config.ts",
    "test": "tsx --test test/*.test.ts",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgres",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "prisma:seed": "tsx prisma/seed.ts",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "docs:validate": "tsx scripts/validate-openapi.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Bloooommmm/Bloom-Backend.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "bugs": {
    "url": "https://github.com/Bloooommmm/Bloom-Backend/issues"
  },
  "homepage": "https://github.com/Bloooommmm/Bloom-Backend#readme",
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "firebase-admin": "^13.10.0",
    "groq-sdk": "^1.6.0",
    "pg": "^8.23.1",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^13.1.0",
    "@eslint/js": "^9.39.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.3",
    "@types/node": "^24.10.1",
    "@types/swagger-ui-express": "^4.1.8",
    "eslint": "^9.39.1",
    "prisma": "^7.10.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4"
  }
}
